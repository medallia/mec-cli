{
  "name": "mec",
  "version": "1.0.0",
  "description": "A command-line tool to interact with Medallia Experience Cloud services",
  "homepage": "https://github.com/medallia/mec-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medallia/mec-cli.git"
  },
  "bugs": {
    "url": "https://github.com/medallia/mec-cli/issues"
  },
  "bin": {
    "mec": "./bin/mec"
  },
  "scripts": {
    "dev": "ts-node bin/mec.ts",
    "build": "tsc",
    "test": "./tests/test-cli.sh && ts-node tests/test-all.ts",
    "lint": "eslint 'src/**/**/*.ts' --fix",
    "format": "prettier --write 'src/**/**/*.ts'",
    "package": "./scripts/package-homebrew.sh",
    "release": "./scripts/release.sh"
  },
  "keywords": [
    "cli",
    "command-line",
    "medallia",
    "experience-cloud",
    "mec",
    "medallia-experience-cloud",
    "surveys",
    "translations"
  ],
  "author": "Rama Adaikkalam <radaikkalam@medallia.com>",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.12.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.4",
    "inquirer": "^12.9.4",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist/**/*.js",
    "bin/mec",
    "package.json",
    "README.md"
  ],
  "lint-staged": {
    "src/**/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
